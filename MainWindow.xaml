<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="650"
        Width="850"
        Background="Black"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header with bot name and ASCII art -->
        <Border Grid.Row="0"
                Background="#F8BBD0"
                CornerRadius="15"
                Padding="15"
                BorderBrush="White"
                BorderThickness="2">

            <StackPanel>

                <TextBlock x:Name="AsciiArt"
                           Foreground="Black"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 1: Chat history area -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="15"
                Padding="15"
                Margin="0,15,0,15"
                BorderBrush="#F8BBD0"
                BorderThickness="3">

            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto">

                <TextBlock x:Name="ChatDisplay"
                           Foreground="Black"
                           FontFamily="Consolas"
                           FontSize="15"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- Row 2: Input box and Send button -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInput"
                     Grid.Column="0"
                     FontSize="16"
                     FontFamily="Consolas"
                     Background="White"
                     Foreground="Black"
                     BorderBrush="#F8BBD0"
                     BorderThickness="3"
                     Padding="10"
                     VerticalContentAlignment="Center"
                     KeyDown="UserInput_KeyDown"/>

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#F8BBD0"
                    Foreground="Black"
                    BorderBrush="White"
                    BorderThickness="2"
                    Margin="10,0,0,0"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>