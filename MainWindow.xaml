<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="700"
        Width="1000"
        MinHeight="620"
        MinWidth="850"
        Background="Black"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <TabControl Background="Black" BorderBrush="#F8BBD0" BorderThickness="2">
            <TabItem Header="Chatbot">
                <Grid Margin="12" Background="Black">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8BBD0"
                            CornerRadius="15"
                            Padding="15"
                            BorderBrush="White"
                            BorderThickness="2">
                        <TextBlock x:Name="AsciiArt"
                                   Foreground="Black"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </Border>

                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="15"
                            Padding="15"
                            Margin="0,15,0,15"
                            BorderBrush="#F8BBD0"
                            BorderThickness="3">
                        <ScrollViewer x:Name="ChatScrollViewer"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ChatDisplay"
                                       Foreground="Black"
                                       FontFamily="Consolas"
                                       FontSize="15"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="UserInput"
                                 Grid.Column="0"
                                 FontSize="16"
                                 FontFamily="Consolas"
                                 Background="White"
                                 Foreground="Black"
                                 BorderBrush="#F8BBD0"
                                 BorderThickness="3"
                                 Padding="10"
                                 VerticalContentAlignment="Center"
                                 KeyDown="UserInput_KeyDown"/>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Content="Send"
                                FontSize="16"
                                FontWeight="Bold"
                                Background="#F8BBD0"
                                Foreground="Black"
                                BorderBrush="White"
                                BorderThickness="2"
                                Margin="10,0,0,0"
                                Click="SendButton_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Task Assistant">
                <Grid Margin="15" Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                               Text="Cybersecurity Task Assistant"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="Black"
                               Margin="0,0,0,15"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Task title:"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,10"/>
                    <TextBox x:Name="TaskTitleInput"
                             Grid.Row="1" Grid.Column="1"
                             Margin="0,0,0,10"
                             Padding="8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Description:"
                               FontWeight="Bold"
                               VerticalAlignment="Top"
                               Margin="0,0,10,10"/>
                    <TextBox x:Name="TaskDescriptionInput"
                             Grid.Row="2" Grid.Column="1"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10"
                             Padding="8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="Reminder:"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,10"/>
                    <TextBox x:Name="TaskReminderInput"
                             Grid.Row="3" Grid.Column="1"
                             ToolTip="Examples: tomorrow, in 3 days, in 2 weeks, or 30 June 2026"
                             Margin="0,0,0,10"
                             Padding="8"/>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Add Task"
                                    Width="120"
                                    Padding="8"
                                    Margin="0,0,10,0"
                                    Background="#F8BBD0"
                                    FontWeight="Bold"
                                    Click="AddTaskButton_Click"/>
                            <Button Content="Mark Complete"
                                    Width="130"
                                    Padding="8"
                                    Margin="0,0,10,0"
                                    Click="CompleteTaskButton_Click"/>
                            <Button Content="Delete"
                                    Width="100"
                                    Padding="8"
                                    Margin="0,0,10,0"
                                    Click="DeleteTaskButton_Click"/>
                            <Button Content="Refresh"
                                    Width="100"
                                    Padding="8"
                                    Click="RefreshTasksButton_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="TaskGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  Height="300"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="Reminder" Binding="{Binding ReminderDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <TextBlock x:Name="TaskStatusText"
                               Grid.Row="5" Grid.ColumnSpan="2"
                               Foreground="DarkBlue"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
