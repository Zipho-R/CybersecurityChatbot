<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="720"
        Width="980"
        MinHeight="650"
        MinWidth="850"
        Background="Black"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="135"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F8BBD0"
                CornerRadius="15"
                Padding="12"
                BorderBrush="White"
                BorderThickness="2">
            <StackPanel>
                <TextBlock Text="CYBERSECURITY AWARENESS ASSISTANT"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="Black"/>
                <TextBlock x:Name="AsciiArt"
                           Foreground="Black"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs"
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    Background="White"
                    BorderBrush="#F8BBD0"
                    BorderThickness="3">

            <TabItem x:Name="ChatTab" Header="Chatbot">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="65"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="10"
                            Padding="12"
                            BorderBrush="#F8BBD0"
                            BorderThickness="2"
                            Margin="0,0,0,10">
                        <ScrollViewer x:Name="ChatScrollViewer"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ChatDisplay"
                                       Foreground="Black"
                                       FontFamily="Consolas"
                                       FontSize="15"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="UserInput"
                                 Grid.Column="0"
                                 FontSize="16"
                                 FontFamily="Consolas"
                                 Background="White"
                                 Foreground="Black"
                                 BorderBrush="#F8BBD0"
                                 BorderThickness="3"
                                 Padding="10"
                                 VerticalContentAlignment="Center"
                                 KeyDown="UserInput_KeyDown"/>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Content="Send"
                                FontSize="16"
                                FontWeight="Bold"
                                Background="#F8BBD0"
                                Foreground="Black"
                                BorderBrush="White"
                                BorderThickness="2"
                                Margin="10,0,0,0"
                                Click="SendButton_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="TasksTab" Header="Task Assistant">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Cybersecurity Task Assistant"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Task title" FontWeight="Bold"/>
                            <TextBox x:Name="TaskTitleInput" Padding="7"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Description" FontWeight="Bold"/>
                            <TextBox x:Name="TaskDescriptionInput" Padding="7"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Reminder (optional)" FontWeight="Bold"/>
                            <TextBox x:Name="TaskReminderInput" Padding="7" ToolTip="Example: in 5 days or 30 June 2026"/>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Content="Add Task"
                                FontWeight="Bold"
                                Background="#F8BBD0"
                                Margin="0,18,0,0"
                                Click="AddTaskButton_Click"/>
                    </Grid>

                    <DataGrid x:Name="TaskGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Reminder" Binding="{Binding ReminderDisplay}" Width="190"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=dd MMM HH:mm}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TaskStatusText"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"
                                   Foreground="DarkSlateGray"/>
                        <Button Content="Refresh"
                                Width="100"
                                Margin="0,0,8,0"
                                Click="RefreshTasksButton_Click"/>
                        <Button Content="Mark Complete"
                                Width="130"
                                Margin="0,0,8,0"
                                Background="#C8E6C9"
                                Click="CompleteTaskButton_Click"/>
                        <Button Content="Delete"
                                Width="100"
                                Background="#FFCDD2"
                                Click="DeleteTaskButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>


            <TabItem x:Name="QuizTab" Header="Cyber Quiz">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Cybersecurity Mini-Game"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="QuizProgressText"
                               Grid.Row="1"
                               Text="Press Start Quiz to begin."
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,12"/>

                    <Border Grid.Row="2"
                            Background="#FCE4EC"
                            BorderBrush="#F8BBD0"
                            BorderThickness="2"
                            CornerRadius="10"
                            Padding="14">
                        <TextBlock x:Name="QuizQuestionText"
                                   Text="Test your knowledge with 12 cybersecurity questions."
                                   FontSize="18"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Border>

                    <ListBox x:Name="QuizOptionsList"
                             Grid.Row="3"
                             FontSize="16"
                             Margin="50,16"
                             Padding="8"
                             IsEnabled="False"/>

                    <TextBlock x:Name="QuizFeedbackText"
                               Grid.Row="4"
                               TextWrapping="Wrap"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               MinHeight="55"
                               Margin="20,5"/>

                    <StackPanel Grid.Row="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="StartQuizButton"
                                Content="Start Quiz"
                                Width="120"
                                Padding="8"
                                Margin="5"
                                Background="#F8BBD0"
                                FontWeight="Bold"
                                Click="StartQuizButton_Click"/>
                        <Button x:Name="SubmitAnswerButton"
                                Content="Submit Answer"
                                Width="130"
                                Padding="8"
                                Margin="5"
                                IsEnabled="False"
                                Click="SubmitAnswerButton_Click"/>
                        <Button x:Name="NextQuestionButton"
                                Content="Next Question"
                                Width="130"
                                Padding="8"
                                Margin="5"
                                IsEnabled="False"
                                Click="NextQuestionButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>


            <TabItem x:Name="ActivityTab" Header="Activity Log">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Chatbot Activity Log"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="ActivitySummaryText"
                               Grid.Row="1"
                               Text="The latest 10 actions are displayed."
                               HorizontalAlignment="Center"
                               Margin="0,8,0,12"/>

                    <ListBox x:Name="ActivityLogList"
                             Grid.Row="2"
                             FontFamily="Consolas"
                             FontSize="14"
                             Margin="15"
                             Padding="10"/>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="Latest 10"
                                Width="110"
                                Padding="8"
                                Margin="5"
                                Click="ShowRecentActivityButton_Click"/>
                        <Button x:Name="ShowMoreActivityButton"
                                Content="Show More"
                                Width="110"
                                Padding="8"
                                Margin="5"
                                Background="#F8BBD0"
                                Click="ShowMoreActivityButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
